{
  "id": "./",
  "name": "Pubblica — GitHub dal browser",
  "short_name": "Pubblica",
  "description": "Pubblica i tuoi progetti su GitHub dal telefono, senza Termux. by Lollo ®2026",
  "lang": "it",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#07070f",
  "theme_color": "#0b0b1a",
  "categories": [
    "developer",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "icone/icona-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icone/icona-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icone/icona-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./condividi",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": [
            ".zip",
            "application/zip",
            "application/x-zip-compressed",
            ".py",
            ".pyw",
            "text/x-python",
            "text/x-script.python",
            ".html",
            ".htm",
            "text/html",
            "text/plain",
            "application/octet-stream"
          ]
        }
      ]
    }
  }
}
